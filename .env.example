# UsefulOps AI local environment example.
# Do not put real secrets in this file.

USEFULOPS_DB=local/data/usefulopsai.sqlite3
USEFULOPS_DOMAIN=usefulopsai.com
USEFULOPS_PUBLIC_OPERATOR="Rowan Vale"
USEFULOPS_PRIMARY_EMAIL=rowan.vale@usefulopsai.com
USEFULOPS_GOG_CLIENT=usefulops

# Optional local-only Stripe key for revenue sync/smoke tests.
# Prefer storing the real value in local/secrets/stripe.env, not in repo files.
STRIPE_API_KEY=
